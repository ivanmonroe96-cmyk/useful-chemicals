---
import { getTranslations, t, localizedPath } from '../i18n/index';
import { defaultLang } from '../i18n/languages';

interface Props {
  lang?: string;
}
const { lang = defaultLang } = Astro.props;
const tr = getTranslations(lang);
const lp = (path: string) => localizedPath(path, lang);
---

<footer class="footer">
  <div class="container">
    <div class="footer-topline">
      <div>
        <h2>{t(tr, 'footer.contact_heading')}</h2>
      </div>
      <div class="footer-proof" aria-label="UE Chemicals trust signals">
        <span><i class="fas fa-flask"></i>{t(tr, 'common.purity_certified')}</span>
        <span><i class="fas fa-box"></i>{t(tr, 'common.core_products')}</span>
        <span><i class="fas fa-truck-fast"></i>{t(tr, 'common.shipping_network')}</span>
      </div>
    </div>
    <div class="footer-grid">
      <div class="footer-brand">
        <a href={lp("/")} class="logo">
          <img src="/images/logo-white.webp" alt="UE Chemicals" />
        </a>
        <p>{t(tr, 'footer.brand_desc')}</p>
        <div class="footer-social">
          <a href="https://wa.me/66954180433" target="_blank" rel="noopener noreferrer" aria-label="WhatsApp +66954180433"><i class="fab fa-whatsapp"></i></a>
          <a href="mailto:info@useful-chemicals.com" aria-label="Email info@useful-chemicals.com"><i class="fas fa-envelope"></i></a>
        </div>
      </div>
      <div class="footer-col">
        <h5>{t(tr, 'footer.quick_links')}</h5>
        <a href={lp("/about/")}><i class="fas fa-building"></i>{t(tr, 'footer.about')}</a>
        <a href={lp("/applications/")}><i class="fas fa-gears"></i>{t(tr, 'footer.applications')}</a>
        <a href={lp("/safety/")}><i class="fas fa-shield-halved"></i>{t(tr, 'footer.safety')}</a>
        <a href={lp("/shipping/")}><i class="fas fa-truck-fast"></i>{t(tr, 'footer.shipping')}</a>
        <a href={lp("/wholesale/")}><i class="fas fa-boxes-stacked"></i>{t(tr, 'footer.wholesale')}</a>
        <a href={lp("/certificates/")}><i class="fas fa-certificate"></i>{t(tr, 'footer.certificates')}</a>
        <a href={lp("/ordering/")}><i class="fas fa-file-invoice"></i>{t(tr, 'footer.ordering')}</a>
        <a href={lp("/faq/")}><i class="fas fa-circle-question"></i>{t(tr, 'footer.faq')}</a>
      </div>
      <div class="footer-col">
        <h5>{t(tr, 'footer.our_products')}</h5>
        <a href={lp("/products/")}><i class="fas fa-boxes-packing"></i>{t(tr, 'nav.products')}</a>
        <a href={lp("/products/caluanie/")}><i class="fas fa-vial"></i>{t(tr, 'nav.caluanie')}</a>
        <a href={lp("/products/red-mercury/")}><i class="fas fa-droplet"></i>{t(tr, 'nav.red_mercury')}</a>
        <a href={lp("/products/silver-mercury/")}><i class="fas fa-flask"></i>{t(tr, 'nav.silver_mercury')}</a>
        <a href={lp("/blog/caluanie-muelear-oxidize-guide/")}><i class="fas fa-book-open"></i>Caluanie Buyer's Guide</a>
        <a href={lp("/blog/red-mercury-2020-258-guide/")}><i class="fas fa-book-open"></i>Red Mercury 20/20-258 Guide</a>
        <a href={lp("/blog/silver-liquid-mercury-guide/")}><i class="fas fa-book-open"></i>Silver Mercury Guide</a>
      </div>
      <div class="footer-col">
        <h5>{t(tr, 'footer.contact_heading')}</h5>
        <a href="mailto:info@useful-chemicals.com"><i class="fas fa-envelope"></i> info@useful-chemicals.com</a>
        <a href="https://wa.me/66954180433" target="_blank" rel="noopener noreferrer"><i class="fab fa-whatsapp"></i> +66954180433</a>
        <a href={lp("/contact/")}><i class="fas fa-map-marker-alt"></i> {t(tr, 'contact.visit_value')}</a>
      </div>
    </div>
    <div class="footer-bottom">
      <p>&copy; {new Date().getFullYear()} {t(tr, 'footer.copyright')}</p>
      <div class="footer-bottom-links">
        <a href={lp("/privacy-policy/")}>{t(tr, 'footer.privacy')}</a>
        <a href={lp("/terms-of-service/")}>{t(tr, 'footer.terms')}</a>
        <a href={lp("/returns-policy/")}>Returns Policy</a>
        <a href={lp("/impressum/")}>{t(tr, 'footer.impressum')}</a>
        <a href={lp("/disclaimer/")}>{t(tr, 'footer.disclaimer')}</a>
      </div>
    </div>
  </div>
</footer>
